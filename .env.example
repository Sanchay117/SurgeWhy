# ============================================================================
# SurgeWhy - Open Agent Hackathon 2026 (Track 2: The Agent That Can Explain Why)
# Copy to .env for live Zetaris + Meterless Nightshift mode.
# Never commit .env or put your NVIDIA API key here (add NVIDIA inside Nightshift).
# ============================================================================

# Offline reproducible sample mode (set to false to query live Zetaris + Nightshift)
SAMPLE_MODE=true

# Layer 01: DATA - Zetaris Unified Semantic Layer & REST SQL API
ZETARIS_BASE_URL=http://localhost:3000
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your-zetaris-api-key-here
ZETARIS_USERNAME=your-sign-in-email
ZETARIS_PASSWORD=your-zetaris-password

# Layer 03: POWER - Meterless Nightshift Runtime & NVIDIA Nemotron Lanes
# Connect via Nightshift Console token; configure NVIDIA API key inside Nightshift Providers tab.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=your-nightshift-runtime-token-here
METERLESS_APP_NAME=surgewhy-agent
METERLESS_SCOPE=user

# Explicit NVIDIA Nemotron dual-lane assignments (for NVIDIA DGX Spark eligibility)
METERLESS_FAST_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
METERLESS_DEEP_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
METERLESS_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Setup Guide Page 24 smoke_test.py compatibility aliases
MODEL_BASE_URL=http://127.0.0.1:8088/v1
MODEL_API_KEY=your-nightshift-runtime-token-here
NEMOTRON_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Web UI server port
SURGEWHY_PORT=8060
